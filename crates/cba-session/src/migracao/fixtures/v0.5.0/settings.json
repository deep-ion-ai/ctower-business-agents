{
  "theme": "dark",
  "permissions": {
    "allow": ["Bash(ls:*)"],
    "deny": ["Read(./.env)", "@REGRA_A@"]
  },
  "hooks": {
    "SessionStart": [{"hooks":[{"type":"command","command":"@HOOK:SessionStart@","timeout":10}]}],
    "UserPromptSubmit": [{"hooks":[{"type":"command","command":"@HOOK:UserPromptSubmit@","timeout":10}]}],
    "PreToolUse": [{"matcher":"Bash","hooks":[{"type":"command","command":"/usr/local/bin/meu-log"}]}, {"hooks":[{"type":"command","command":"@HOOK:PreToolUse@","timeout":10}]}],
    "Notification": [{"hooks":[{"type":"command","command":"@HOOK:Notification@","timeout":10}]}],
    "Stop": [{"hooks":[{"type":"command","command":"say pronto"}]}, {"hooks":[{"type":"command","command":"@HOOK:Stop@","timeout":10}]}],
    "SessionEnd": [{"hooks":[{"type":"command","command":"@HOOK:SessionEnd@","timeout":10}]}]
  }
}
